# Keep the build context small and never copy host node_modules — native
# @libsql/client bindings must match the image arch, not the machine that
# invoked `docker build`.

.git
.github
.grok
.superset
.quintal
.vscode
.idea
.DS_Store

# Secrets and local state
.env
.env.*
!.env.example
data
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
coverage
plan

# Installed / built artefacts — the image builds these itself
node_modules
**/node_modules
**/.next
**/dist
**/*.tsbuildinfo
next-env.d.ts

# Desktop host: only its package.json is needed for the workspace install
apps/desktop/**
!apps/desktop/package.json

# Marketing site: not part of the office image
apps/website/**
!apps/website/package.json

# Generated at build time
apps/web/public/assets/maps/
packages/acp-harness/src/runner/base-prompt.text.ts
packages/acp-harness/src/nest-agents.text.ts

# Not needed to build or run the office
scripts
tools
screenshots
docs
CONTRIBUTING.md
LICENSE
LICENSE-FAQ.md
RELEASING.md
README.md
SELF_HOSTING.md
justfile
compose.yml
**/*.md
!packages/acp-harness/base_prompt.md
!packages/acp-harness/nest_agents.md
!apps/web/public/assets/CREDITS.md
