{
  "name": "@quintal/shared",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "default": "./dist/db/index.js"
    },
    "./db/testing": {
      "types": "./dist/db/testing.d.ts",
      "default": "./dist/db/testing.js"
    },
    "./maps": {
      "types": "./dist/maps/index.d.ts",
      "default": "./dist/maps/index.js"
    }
  },
  "files": [
    "dist",
    "drizzle",
    "maps"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "db:studio": "drizzle-kit studio",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "admin": "tsx src/cli/admin.ts"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.76",
    "@libsql/client": "^0.17.4",
    "@noble/curves": "^2.3.0",
    "@noble/hashes": "^2.3.0",
    "@scure/base": "^2.3.0",
    "dotenv": "^17.2.4",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3"
  }
}
