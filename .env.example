# Quintal environment
#
# Copy to `.env` at the repo root — one file for the web app, the game server
# and the db scripts. Everything below is optional except where marked
# REQUIRED IN PRODUCTION; `pnpm dev` works with this file untouched.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Optional. Port for the unified production process (web + game server).
# Default: 3000 in production, 2567 for the dev game server.
# In development this is ignored: `next dev` owns :3000 and the game server :2567.
# PORT=3000

# Optional. Interface to bind. Default: 0.0.0.0
# HOST=0.0.0.0

# Optional. Set by the run scripts; you rarely need it by hand.
# NODE_ENV=production

# ---------------------------------------------------------------------------
# Database (SQLite via libSQL)
# ---------------------------------------------------------------------------

# Optional. Default: file:./data/quintal.db
# Relative `file:` paths resolve from the repo root, not the current directory.
# The same variable accepts a remote libSQL URL (e.g. Turso) with no other
# changes: DATABASE_URL=libsql://your-db.turso.io
DATABASE_URL=file:./data/quintal.db

# Optional. Only for remote libSQL (Turso) — ignored for local `file:` databases.
# DATABASE_AUTH_TOKEN=

# Optional. Overrides the base directory relative `file:` paths resolve against.
# QUINTAL_DATA_ROOT=/var/lib/quintal

# Migrations run automatically on server boot. You never need drizzle-kit to
# self-host.

# ---------------------------------------------------------------------------
# Auth (Better Auth sessions, keypair sign-in)
#
# Signing in means signing a challenge with a secp256k1 key you hold. There is
# no email to deliver, no password to store and no provider to configure — so
# there is nothing in this section but the two values below.
# ---------------------------------------------------------------------------

# REQUIRED IN PRODUCTION. Signs sessions and tokens. Generate one with:
#   openssl rand -base64 32
# In development a well-known fallback is used and a warning is printed.
# BETTER_AUTH_SECRET=

# REQUIRED IN PRODUCTION. Public origin of the deployment. Every sign-in
# signature is bound to it, so a signature made for one deployment cannot be
# replayed against another — set it to the origin people actually visit.
# Default: http://localhost:3000
# BETTER_AUTH_URL=https://office.example.com

# --- running two offices on one machine (development) ------------------------
#
# Two instances is how you check that two offices are genuinely separate, and
# how anything about multiplayer gets tested against more than one server. Both
# dev ports move, and BETTER_AUTH_URL follows the web port on its own — sign-in
# is bound to an origin, so an office on another port would otherwise refuse its
# own sign-ins.
#
# Give the second one its own database too, or they are one office wearing two
# addresses:
#
#   QUINTAL_WEB_PORT=3100 QUINTAL_GAME_PORT=2667 \
#     DATABASE_URL=file:./data/second.db pnpm dev
#
# Then point the desktop app at http://localhost:3100. Not 127.0.0.1 — same
# server, different origin, and sign-in will refuse it.
# QUINTAL_WEB_PORT=3000
# QUINTAL_GAME_PORT=2567

# ---------------------------------------------------------------------------
# Seed script (pnpm db:seed)
# ---------------------------------------------------------------------------

# Optional. Seed a workspace for a key you already hold (hex or npub). With
# this unset the seed mints a fresh keypair and prints the nsec once.
# SEED_PUBKEY=npub1...

# Optional. Display name for the seeded identity. Defaults to a truncated npub.
# SEED_NAME=Demo Human

# ---------------------------------------------------------------------------
# Advanced
# ---------------------------------------------------------------------------

# Optional. Where the built Next.js app lives, if you move it.
# Default: ../web relative to apps/server
# QUINTAL_WEB_DIR=
