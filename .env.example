# Quintal environment
#
# Copy to `.env` at the repo root — one file for the web app, the game server
# and the db scripts. Everything below is optional except where marked
# REQUIRED IN PRODUCTION; `pnpm dev` works with this file untouched.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

# Optional. Port for the unified production process (web + game server).
# Default: 3000 in production, 2567 for the dev game server.
# In development this is ignored: `next dev` owns :3000 and the game server :2567.
# PORT=3000

# Optional. Interface to bind. Default: 0.0.0.0
# HOST=0.0.0.0

# Optional. Set by the run scripts; you rarely need it by hand.
# NODE_ENV=production

# ---------------------------------------------------------------------------
# Database (SQLite via libSQL)
# ---------------------------------------------------------------------------

# Optional. Default: file:./data/quintal.db
# Relative `file:` paths resolve from the repo root, not the current directory.
# The same variable accepts a remote libSQL URL (e.g. Turso) with no other
# changes: DATABASE_URL=libsql://your-db.turso.io
DATABASE_URL=file:./data/quintal.db

# Optional. Only for remote libSQL (Turso) — ignored for local `file:` databases.
# DATABASE_AUTH_TOKEN=

# Optional. Overrides the base directory relative `file:` paths resolve against.
# QUINTAL_DATA_ROOT=/var/lib/quintal

# Migrations run automatically on server boot. You never need drizzle-kit to
# self-host.

# ---------------------------------------------------------------------------
# Auth (Better Auth, email magic link)
# ---------------------------------------------------------------------------

# REQUIRED IN PRODUCTION. Signs sessions and tokens. Generate one with:
#   openssl rand -base64 32
# In development a well-known fallback is used and a warning is printed.
# BETTER_AUTH_SECRET=

# REQUIRED IN PRODUCTION. Public origin of the deployment — magic links are
# built from it. Default: http://localhost:3000
# BETTER_AUTH_URL=https://office.example.com

# ---------------------------------------------------------------------------
# Email delivery for magic links
#
# Three tiers, checked in this order:
#   1. RESEND_API_KEY set -> Resend
#   2. SMTP_HOST set      -> generic SMTP
#   3. neither            -> the link is printed to the server console
# The third tier is a real, supported way to self-host a solo instance.
# ---------------------------------------------------------------------------

# Optional. Resend API key.
# RESEND_API_KEY=

# Optional. Generic SMTP. SMTP_HOST alone is enough for an unauthenticated relay.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false          # implicit TLS; defaults to true when SMTP_PORT=465

# Optional. From address on outgoing mail. Default: Quintal <noreply@localhost>
# EMAIL_FROM=Quintal <office@example.com>

# ---------------------------------------------------------------------------
# Seed script (pnpm db:seed)
# ---------------------------------------------------------------------------

# Optional. Demo account created by the seed. Defaults shown.
# SEED_EMAIL=demo@quintal.local
# SEED_NAME=Demo Human

# ---------------------------------------------------------------------------
# Voice (LiveKit) — optional
# ---------------------------------------------------------------------------
#
# Proximity voice between humans. Leave unset and the office works exactly as
# before, minus voice: the UI says so rather than failing.
#
# Get these from a LiveKit Cloud project (Settings -> Keys), or point them at a
# self-hosted livekit-server. There is no region to choose: Cloud projects are
# unpinned by default and route to the nearest edge. Region pinning is a paid
# feature and only matters once you record anything.
#
# LIVEKIT_URL is read on the server and handed to the browser with each token,
# rather than being a NEXT_PUBLIC_ variable — so one built image can serve any
# LiveKit project instead of baking one in.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Advanced
# ---------------------------------------------------------------------------

# Optional. Where the built Next.js app lives, if you move it.
# Default: ../web relative to apps/server
# QUINTAL_WEB_DIR=
